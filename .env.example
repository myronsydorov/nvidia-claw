# NVIDIA Build hosted inference (ADR-0003)
NVIDIA_API_KEY=

# OpenClaw gateway — loopback only (AGENTS invariant #4)
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=

# Warden app API auth (CONTRACTS §3, bearer device token)
WARDEN_DEVICE_TOKEN=

# Sandbox driver: "mock" for local dev; unset for the real OpenShell driver (ADR-0001, T-04)
CUSTODY_SANDBOX=mock

# Adapter secrets, injected by the OpenShell provider store (CONTRACTS §1)
DHL_API_KEY=

# Relay mailbox (CONTRACTS §2)
RELAY_URL=
