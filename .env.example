# NVIDIA Build hosted inference (ADR-0003), OpenAI-compatible. The key is never logged.
NVIDIA_API_KEY=
CUSTODY_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
CUSTODY_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
CUSTODY_MODEL_CODE=nvidia/nemotron-3-super-120b-a12b

# OpenClaw gateway — loopback only (AGENTS invariant #4)
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=

# Warden app API auth (CONTRACTS §3, bearer device token)
WARDEN_DEVICE_TOKEN=

# Warden's SQLite file (T-07)
WARDEN_DB_PATH=warden.db

# Sandbox driver: "mock" for local dev; unset for the real OpenShell driver (ADR-0001, T-04)
CUSTODY_SANDBOX=mock

# Replay recorded model answers instead of calling NVIDIA Build (dev/e2e only, requires
# CUSTODY_SANDBOX=mock; `make dev` sets it when NVIDIA_API_KEY is empty). The real compiler
# pipeline (gate, policy, dry run) still runs on them.
# CUSTODY_LLM_REPLAY=warden/tests/fixtures/llm/replay.json

# Adapter secrets, injected by the OpenShell provider store (CONTRACTS §1)
DHL_API_KEY=

# Relay mailbox (CONTRACTS §2)
RELAY_URL=
